# GrowthPilot Configuration - Group 904
# Anthropic API key (from the hackathon email). Without it the agent still works in deterministic mode.
ANTHROPIC_API_KEY=

# Optional alternative provider
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Required hackathon model
MODEL_NAME=claude-haiku-5-5

# Database: local SQLite by default. For production set a hosted Postgres URL, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./growthpilot.db

# Server port
PORT=8000
