# GrowthPilot Configuration - Group 904
# Supported providers: Anthropic direct OR OpenRouter

# Anthropic API Key (from hackathon email)
ANTHROPIC_API_KEY=

# OR OpenRouter API Key (alternative)
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Preferred Model: claude-haiku-5-5 or claude-3-5-haiku
MODEL_NAME=claude-3-5-haiku-20241022

# Database: SQLite by default; set PostgreSQL / Supabase URL for cloud deployment
DATABASE_URL=sqlite:///./growthpilot.db

# Server Port
PORT=8000
